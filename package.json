{
  "name": "analytics-service",
  "version": "1.0.0",
  "description": "Omnixys Analytics & Insights Platform",
  "author": {
    "name": "Caleb Gyamfi",
    "email": "caleb.gyamfi@omnixys.com",
    "url": "https://omnixys.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omnixys/user-service.git"
  },
  "bugs": {
    "url": "https://github.com/omnixys/user-service/issues"
  },
  "homepage": "https://omnixys.com",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "private": false,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.10.0",
    "pnpm": ">=10.33.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  
  "scripts": {
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && nest build",
    "format": "prettier --cache --write \"src/**/*.{ts,js,json,prisma,md,yaml}\"",
    "format:test": "prettier --cache --write \"src/**/*.{ts,js,json,prisma,md,yaml}\" \"__tests__/**/*.ts\"",
    "format:check": "prettier --cache --check \"src/**/*.{ts,js,json,prisma,md,yaml,yml}\" \"__test__/**/*.ts\"",
    "start": "pnpm nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "dev": "pnpm run clean && nest start --watch",
    "test": "pnpm run prisma:generate && pnpm run build && node --test test/*.test.mjs",
    "test:unit": "pnpm run build && node --test test/error-contract.test.mjs",
    "test:helm": "helm lint deploy/helm/analytics-service && helm template analytics deploy/helm/analytics-service",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prisma:generate": "prisma generate",
    "typedoc": "typedoc",
    "depcheck": "depcheck",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:validate": "tsx prisma/validate.ts",
    "prisma:push": "prisma db push",
    "prisma:pull": "prisma db pull",
    "prisma:reset:locale": "prisma migrate reset --force && prisma migrate dev && tsx prisma/seed.locale.ts",
    "reset": "prisma migrate reset --force",
    "generate": "pnpm prisma format && pnpm prisma validate && prisma generate",
    "release": "semantic-release",
    "deps:audit": "tsx scripts/dependency-audit.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@apollo/subgraph": "^2.14.3",
    "@as-integrations/fastify": "^3.1.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@nestjs/apollo": "^13.4.2",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/platform-fastify": "^11.1.28",
    "@omnixys/grpc-ts": "^1.1.0",
    "@omnixys/analytics-rule-engine": "1.0.0",
    "@omnixys/cache-ts": "^3.2.0",
    "@omnixys/context-ts": "^3.1.1",
    "@omnixys/contracts-ts": "^3.3.0",
    "@omnixys/graphql-ts": "^3.1.2",
    "@omnixys/kafka-ts": "^3.2.1",
    "@omnixys/http-ts": "^1.0.1",
    "@omnixys/logger-ts": "^3.2.2",
    "@omnixys/observability-ts": "^3.2.2",
    "@omnixys/security-ts": "^4.0.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "cfonts": "^3.3.1",
    "chalk": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cron-parser": "^5.6.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "graphql": "^16.14.2",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@prisma/extension-accelerate": "^3.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tsconfig/node23": "^23.0.4",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-sort-imports": "^1.8.11",
    "prisma": "^7.9.0",
    "semantic-release": "^25.0.8",
    "tsx": "^4.23.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "pnpm": {
    "overrides": {
      "fastify": "5.8.5"
    }
  }
}
