{
  "name": "analytics-service",
  "version": "1.0.0",
  "description": "Omnixys Analytics & Insights Platform",
  "type": "module",
  "private": true,
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "test": "pnpm run prisma:generate && pnpm run build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "release": "semantic-release"
  },
  "dependencies": {
    "@apollo/subgraph": "^2.14.3",
    "@nestjs/apollo": "^13.4.2",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/platform-fastify": "^11.1.28",
    "@omnixys/cache": "link:../../packages/ts/cache",
    "@omnixys/analytics-rule-engine": "link:../../packages/ts/analytics-rule-engine",
    "@omnixys/context": "link:../../packages/ts/context",
    "@omnixys/contracts": "link:../../packages/ts/contracts",
    "@omnixys/graphql": "link:../../packages/ts/graphql",
    "@omnixys/kafka": "link:../../packages/ts/kafka",
    "@omnixys/logger": "link:../../packages/ts/logger",
    "@omnixys/observability": "link:../../packages/ts/observability",
    "@omnixys/security": "link:../../packages/ts/security",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cron-parser": "^5.6.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "graphql": "^16.14.2",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "prisma": "^7.9.0",
    "semantic-release": "^25.0.8",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "pnpm@11.15.1",
  "license": "GPL-3.0-or-later"
}
