{
  "name": "notification-service",
  "version": "2.1.0",
  "description": "Omnixys Notification Service",
  "author": {
    "name": "Caleb Gyamfi",
    "email": "caleb.gyamfi@omnixys.com",
    "url": "https://omnixys.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omnixys/notification-service.git"
  },
  "bugs": {
    "url": "https://github.com/omnixys/notification-service/issues"
  },
  "homepage": "https://omnixys.com",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "private": false,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=25.8.2",
    "pnpm": ">=10.33.0"
  },
  "scripts": {
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "build": "pnpm run clean && nest build",
    "format": "prettier --cache --write \"src/**/*.{ts,js,json,prisma,md,yaml}\"",
    "format:test": "prettier --cache --write \"src/**/*.{ts,js,json,prisma,md,yaml}\" \"__tests__/**/*.ts\"",
    "format:check": "prettier --cache --check \"src/**/*.{ts,js,json,prisma,md,yaml,yml}\" \"__test__/**/*.ts\"",
    "start": "pnpm nest start",
    "dev": "pnpm exec prisma generate && pnpm run clean && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "pnpm run build && node --test __tests__/unit/*.test.mjs",
    "test:integration": "pnpm run build && node --test __tests__/integration/*.test.mjs",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e:debug": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --detectOpenHandles --config ./__tests__/jest-e2e.json",
    "test:e2e2": "jest --config ./__tests__/jest-e2e.json",
    "test:e2e": "NODE_OPTIONS='--experimental-vm-modules' jest __tests__/e2e/resolvers/resolvers.integration.e2e-spec.ts --runInBand --config ./jest-e2e.json --coverage=false",
    "typedoc": "typedoc",
    "depcheck": "depcheck",
    "test:login": "pnpm test -- __tests__/e2e/notification/notification.login.e2e-spec.ts",
    "test:signup": "pnpm test -- __tests__/e2e/notification/notification.signup.e2e-spec.ts",
    "test:notification": "pnpm test -- __tests__/e2e/notification/notification.notification.e2e-spec.ts",
    "test:admin": "pnpm test -- __tests__/e2e/notification/notification.admin.e2e-spec.ts",
    "prepare": "husky",
    "prisma:migrate": "prisma migrate dev",
    "reset": "prisma migrate reset --force && prisma migrate dev && tsx prisma/seed.ts",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:validate": "tsx prisma/validate.ts",
    "prisma:push": "prisma db push",
    "prisma:pull": "prisma db pull",
    "generate": "pnpm prisma format && pnpm prisma validate && prisma generate",
    "release": "semantic-release"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@apollo/subgraph": "^2.14.2",
    "@as-integrations/fastify": "^3.1.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@nestjs/apollo": "^13.4.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/platform-fastify": "^11.1.27",
    "@nestjs/terminus": "^11.1.1",
    "@omnixys/cache": "file:../../packages/ts/cache",
    "@omnixys/context": "file:../../packages/ts/context",
    "@omnixys/contracts": "file:../../packages/ts/contracts",
    "@omnixys/graphql": "file:../../packages/ts/graphql",
    "@omnixys/kafka": "file:../../packages/ts/kafka",
    "@omnixys/logger": "file:../../packages/ts/logger",
    "@omnixys/observability": "file:../../packages/ts/observability",
    "@omnixys/security": "file:../../packages/ts/security",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "axios": "^1.18.1",
    "cfonts": "^3.3.1",
    "chalk": "^5.6.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "depcheck": "^1.4.7",
    "dotenv": "^17.4.2",
    "fastify": "5.8.5",
    "geoip-lite": "^2.0.3",
    "graphql": "^16.14.2",
    "handlebars": "^4.7.9",
    "jwks-rsa": "^3.2.2",
    "kafkajs": "^2.2.4",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ua-parser-js": "^2.0.10"
  },
  "devDependencies": {
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "latest",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.27",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.15.43",
    "@tsconfig/node23": "^23.0.4",
    "@types/express": "^5.0.6",
    "@types/geoip-lite": "^1.4.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.0",
    "@types/nodemailer": "^7.0.12",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-sort-imports": "^1.8.11",
    "prisma": "^7.8.0",
    "semantic-release": "^25.0.5",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0"
  },
  "pnpm": {
    "overrides": {
      "fastify": "5.8.5"
    }
  }
}
